# ==============================================================================
# NexaMonitor Environment Configuration Template
# Monitor. Analyze. Optimize.
# ==============================================================================

# Backend Server Configuration
APP_NAME=NexaMonitor
VERSION=7.0.0
DEBUG=True
LOG_LEVEL=INFO

# Security & CORS
# In production, specify exact domain origins rather than wildcards
SECRET_KEY=generate-a-strong-random-secret-key-for-production
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80","http://localhost"]

# Database Connection (SQLite with WAL mode)
# Development local path: sqlite:///./nexamonitor.db
# Production container path: sqlite:////data/nexamonitor.db
DATABASE_URL=sqlite:///./nexamonitor.db

# Docker Engine Connection
# Unix socket (Linux / macOS Docker Desktop / Podman):
DOCKER_HOST=unix:///var/run/docker.sock
# TCP socket (remote Docker daemon or Windows):
# DOCKER_HOST=tcp://127.0.0.1:2375
DOCKER_TIMEOUT=5

# Monitoring Engine Frequencies (milliseconds)
MONITORING_INTERVAL_MS=1000
PERSISTENCE_INTERVAL_MS=5000
RETENTION_DAYS=30

# Alert Threshold Defaults
CPU_WARNING_THRESHOLD=75.0
CPU_CRITICAL_THRESHOLD=90.0
MEMORY_WARNING_THRESHOLD=80.0
MEMORY_CRITICAL_THRESHOLD=95.0
DISK_WARNING_THRESHOLD=85.0
DISK_CRITICAL_THRESHOLD=95.0

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
